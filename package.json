{
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/server.js",
    "dev": "tsx watch src/server.ts",
    "css:build": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --watch",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "tsx src/features/seed/seed.ts"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  }
}
